# ─────────────────────────────────────────────────────────────────────────
#  TESTUMGEBUNG — wegwerfbare Werte, absichtlich im Repo
# ─────────────────────────────────────────────────────────────────────────
#  Diese Datei richtet die e2e-Tests auf eine LOKALE Wegwerf-Datenbank aus.
#  Vorher liefen sie gegen dieselbe Atlas-Datenbank wie die Produktion — sie
#  schreiben aber Daten (nehmen Klienten in Touren auf) und setzen bei jedem
#  Lauf das 2FA-Geheimnis des Testkontos zurück. Das hat in einer Datenbank
#  mit echten Mandanten nichts zu suchen.
#
#  Die Secrets hier sind bewusst öffentlich: sie schützen nichts als eine
#  leere lokale Datenbank, die `pnpm run test:db:reset` jederzeit neu aufbaut.
#  NIEMALS einen dieser Werte in .env oder in Vercel übernehmen.
#
#  Nutzung:  pnpm run test:db:up && pnpm run test:db:reset && pnpm run test:e2e
# ─────────────────────────────────────────────────────────────────────────

# Lokale MongoDB aus docker-compose.yml (Host-Port 27018, Single-Node-Replica-
# Set — das Replica-Set ist Pflicht, weil Payload Transaktionen nutzt).
# Eigener Datenbankname, damit eine lokale Entwicklungs-DB unberührt bleibt.
DATABASE_URI=mongodb://localhost:27018/pflegelotse_test?replicaSet=rs0&directConnection=true

PAYLOAD_SECRET=7cd1d5b891ed06a0a418b1e847dffada477686e7abe818997854bee95b1ba970
ENCRYPTION_MASTER_KEY=bsz0pBUaQyf0nbFI5humEApq3QHyqSj16FtRBJGm2EY=
AUDIT_PEPPER=743bfc313a62797bcf89364c10f3bc2bc878012293d6c6e1
AUDIT_PEPPER_VERSION=test-v1

# Eigener Port 3001: so kann ein normaler `pnpm dev` (gegen .env, also die
# echte DB) parallel auf 3000 weiterlaufen, ohne dass Playwright ihn
# versehentlich als Testserver verwendet.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Luftlinie statt echtem Routing: deterministisch, ohne Netzzugriff — Tests
# sollen nicht von der Erreichbarkeit des OSRM-Servers abhängen. Der
# Luftlinien-Banner ist damit im Test sichtbar; dashboard.spec.ts prüft
# ohnehin gegen den tatsächlichen Health-Zustand, nicht gegen eine Annahme.
ROUTING_PROVIDER=haversine
OSRM_PROFILE=driving

# Geocoding bleibt auf dem öffentlichen Nominatim (einzelne Anfragen in
# marketplace.spec.ts). Eigener User-Agent, damit Testlast erkennbar ist.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=PflegeLotse-Test/1.0 (+https://github.com/fgirse/pflegelotse-deutschland-200)

# Bewusst LEER: kein Mailversand, keine Zahlungen, keine KI-Aufrufe im Test.
# Ohne Schlüssel laufen die jeweiligen Pfade in ihren No-Op-/Konsolen-Modus.
RESEND_API_KEY=
NOTIFY_ENABLED=
MOLLIE_API_KEY=
ANTHROPIC_API_KEY=

# App-Verschlüsselung statt CSFLE (kein mongocrypt in der Testumgebung nötig).
CSFLE_ENABLED=false
